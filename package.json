{
  "name": "zealbot",
  "version": "1.0.0",
  "description": "ZealBot — self-hosted multi-server Discord bot: moderation, economy, tickets, AI, dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dashboard": "node src/dashboard/index.js",
    "deploy": "node deploy-commands.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/smoke-test.js",
    "setup": "node scripts/setup.js",
    "admin": "node scripts/admin.js",
    "verify": "node_modules/.bin/tsc -p packages/commander/tsconfig.json && node scripts/smoke-test.js",
    "build:commander": "node_modules/.bin/tsc -p packages/commander/tsconfig.json",
    "test:unit": "vitest run",
    "lint": "eslint src/ scripts/ test/",
    "format": "prettier --write src/ scripts/ test/",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "bot",
    "discord.js",
    "multi-server",
    "self-hosted",
    "moderation",
    "economy",
    "tickets",
    "ai",
    "typescript",
    "nodejs",
    "commander-architecture",
    "guardian",
    "zealbot"
  ],
  "author": "zema-tech",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zema-tech/zealbot-discord.git"
  },
  "homepage": "https://github.com/zema-tech/zealbot-discord#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@discord-player/extractor": "7.2.0",
    "@discordjs/voice": "0.19.2",
    "discord-player": "7.2.0",
    "discord-player-youtubei": "3.1.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ms": "^2.1.3",
    "simple-ytdl-core": "1.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/zema-tech/zealbot-discord/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "vitest": "^3.2.7"
  }
}
