# Discord bot token (required)
DISCORD_TOKEN=il_tuo_token_qui

# Application Client ID (required for command deploy)
CLIENT_ID=il_tuo_client_id

# Optional: Guild ID to test commands on a single server (faster)
# GUILD_ID=id_del_server_di_test

# Optional: AI config (commands /chiedi, /riassumi, /codice, /analizza...).
# ONE key is enough: the bot picks the provider itself (auto). Hermes-inspired
# (catalog + alias + key pools + failover) and Composio for MCP.
# Aliases: claude=anthropic, google=gemini, grok=xai, hf=huggingface.
# AI_MODEL accepts "provider:model" (e.g. groq:llama-3.3-70b-versatile).
# Key pools: "sk-a,sk-b" = rotation + key failover (credential pools).
# AI_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# XAI_API_KEY=xai-...
# TOGETHER_API_KEY=...
# CEREBRAS_API_KEY=csk-...
# FIREWORKS_API_KEY=fw_...
# NOVITA_API_KEY=...
# HF_TOKEN=hf_...
# NVIDIA_API_KEY=nvapi-...
# KIMI_API_KEY=...
# OPENAI_BASE_URL= (endpoint override, also GROQ_BASE_URL, MISTRAL_BASE_URL...)
# AI_FALLBACKS=groq,openrouter
# OLLAMA_HOST=http://localhost:11434 (AI_PROVIDER=ollama: local AI, zero cloud, no keys)
# AI_MODEL= (optional: custom model, sensible provider default)
# AI_API_URL=https://text.pollinations.ai (free default, no key needed)
# AI_API_KEY=

# Daily AI call limit on a shared key (default 500, 0 = unlimited).
# AI_DAILY_LIMIT=500

# MCP client direction B (the bot calls external MCP servers, Hermes style).
# Config in mcp/servers.json (copy from mcp/servers.example.json, NEVER commit tokens).
# MCP_ENABLED=1 (0 = client off, the POST /mcp server stays on)
# MCP_SERVERS_PATH=./mcp/servers.json
# MCP_TIMEOUT=30000

# Storage: 'json' (default, src/database/*.json files) or 'sqlite'
# (kv table via node:sqlite, Node 22+, zero new dependencies).
# DB_BACKEND=json
# DB_SQLITE_PATH=./data/bot.db

# Structured logging (JSON-lines on console + logs/YYYY-MM-DD.log).
# Levels: debug, info (default), warn, error.
# LOG_LEVEL=info
# LOG_DIR=logs

# Nightly self-improvement: the bot re-reads its code every evening and proposes/applies 1 patch.
# Never auto-commits: review with git diff. OFF by default.
# SELF_IMPROVE=1
# SELF_IMPROVE_TIME=22:00
# SELF_IMPROVE_DRY_RUN=1
# SELF_IMPROVE_GUILD_ID=report_destination_server_id

# JARVIS agents (/jarvis command + /agents.html control-room).
# VAULT_KEY: service-login vault key (min 16 chars, NEVER commit it).
# Without it, the vault is disabled and agents can't use logged-in services.
# VAULT_KEY=cambia_questa_chiave_lunga_casuale
# JARVIS_TASK_TIMEOUT_MS=120000 (max time per task, min 10s, max 10min)
# JARVIS_APPROVAL_TIMEOUT_MS=120000 (human approval wait, then deny)
# JARVIS_MAX_STEPS=3 (ReAct steps per specialist, max 8)

# Web dashboard (SEPARATE process from the bot: npm run dashboard).
# Shares .env and DB store with the bot (same dir for json, same sqlite file).
# The bot writes the server roster (presence); the dashboard reads live details via REST.
# Prerequisites: Discord app with OAuth2 redirect to <BASE_URL>/callback (scope identify+guilds).
# DASHBOARD_PORT=3000
# SESSION_SECRET=generate_a_long_random_string_of_at_least_32_characters
# CLIENT_SECRET=your_discord_app_client_secret
# BASE_URL=http://localhost:3000
# Dashboard audit log file path (default data/dashboard-audit.log).
# DASHBOARD_AUDIT_LOG=data/dashboard-audit.log
